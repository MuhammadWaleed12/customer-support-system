{
  "name": "support-desk-ai",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint backend/src backend/prisma frontend/src --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "pnpm --filter backend test:unit && pnpm --filter frontend test",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "db:seed": "pnpm --filter backend db:seed",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:migrate:deploy": "pnpm --filter backend db:migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}

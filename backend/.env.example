# Supabase Postgres — pooled connection for runtime queries (port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct connection for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Anthropic API key for router + sub-agents
ANTHROPIC_API_KEY=""

# Small/fast model for router classification (generateObject, no tools, no streaming)
ROUTER_MODEL="claude-haiku-4-5-20251001"

# Stronger model for sub-agents (streamText, tool calling)
AGENT_MODEL="claude-sonnet-5"

PORT=3001

# Set to "production" on Railway (or any real deployment) so session cookies
# get secure: true; sameSite: "none" — required for the cookie to survive a
# cross-origin request from the Vercel frontend. Leave unset for local dev:
# that combination requires HTTPS, which localhost doesn't have.
# NODE_ENV=production
